# NetCoop AI — Operational & Security Configuration Template
# Copy to .env for local deployment. NEVER commit real secrets to version control.

# Live Infrastructure Mutation Guard (Default: false / safe simulation-only)
# When set to false or unset, all live network mutation is strictly disabled.
NETCOOP_ENABLE_LIVE_EXECUTION=false

# HMAC-SHA256 Operator Authorization Secret Key
# Used to verify cryptographically signed operator approval records.
# Leave empty or set a placeholder in development; never store in source code.
NETCOOP_OPERATOR_SECRET_KEY=replace_with_secure_operator_hmac_secret_in_production

# Logging and Operational Modes
NETCOOP_LOG_LEVEL=INFO
NETCOOP_STRICT_FRESHNESS=true
